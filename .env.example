# ============================================================
# Project Sentinel — .env.example
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git. It is in .gitignore.
# NEVER put API keys in config.yaml.
#
# During build phase: set MOCK_MODE=true
# All API calls return realistic mock data.
# No paid subscriptions required to build and test the system.
#
# When ready to go live: set MOCK_MODE=false
# and add your real API keys below.
# ============================================================

# ─────────────────────────────────────────────
# SYSTEM MODE
# ─────────────────────────────────────────────

# Set to true during build phase — no real API keys needed
# Set to false when you have all keys and are ready for live data
MOCK_MODE=true

# ─────────────────────────────────────────────
# ZERODHA KITE CONNECT
# ─────────────────────────────────────────────
# Get from: https://developers.kite.trade/
# Cost: ₹500/month for API subscription
# Historical data: FREE since February 8, 2025
# IMPORTANT: Static IP must be whitelisted at Zerodha first
#            (mandatory since April 1, 2025)

ZERODHA_USER_ID=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# ─────────────────────────────────────────────
# TWELVE DATA (Primary Forex + Global Data)
# ─────────────────────────────────────────────
# Get from: https://twelvedata.com/
# Free tier: 800 requests/day, 8/minute
# Paid tier: $29/month (Grow plan) if you need more
# Used for: Forex OHLCV, Global indices, Real-time rates

TWELVE_DATA_API_KEY=

# ─────────────────────────────────────────────
# ALPHA VANTAGE (Fallback Data Source)
# ─────────────────────────────────────────────
# Get from: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/day (very limited — fallback only)
# Used as: Emergency fallback when Twelve Data is unavailable

ALPHA_VANTAGE_API_KEY=

# ─────────────────────────────────────────────
# FRED (Federal Reserve Economic Data)
# ─────────────────────────────────────────────
# Get from: https://fred.stlouisfed.org/docs/api/api_key.html
# Cost: Completely FREE
# Used for: DXY (DTWEXBGS), US 10Y yield, Fed Funds rate
#           US 2Y yield, PCE inflation, unemployment

FRED_API_KEY=

# ─────────────────────────────────────────────
# FINANCIAL MODELING PREP (Fundamental Data)
# ─────────────────────────────────────────────
# Get from: https://financialmodelingprep.com/developer/docs/
# Cost: $15/month (Starter plan covers Indian + US equities)
# Used for: PE ratios, ROE, revenue growth, earnings data
# Sprint: Required from Sprint 2 onwards

FMP_API_KEY=

# ─────────────────────────────────────────────
# ANTHROPIC API (LLM Narration Layer)
# ─────────────────────────────────────────────
# Get from: https://console.anthropic.com/
# Cost: Pay per use — estimated ₹800-1,500/month at our usage
# Used for: Narrating Trade Research Cards in plain English
#           Summarising concall transcripts
#           Morning brief narrative generation
# Model: claude-sonnet-4-20250514 (NOT Opus — faster + cheaper for agents)
# NOTE: LLMs are NEVER used for price signals. Narration only.

ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# TELEGRAM BOT (Alerts and Reports)
# ─────────────────────────────────────────────
# Create a bot: talk to @BotFather on Telegram
# Get chat ID: talk to @userinfobot on Telegram
# Cost: Free

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# NEWS API (Market News Scanning)
# ─────────────────────────────────────────────
# Get from: https://newsapi.org/
# Free tier: 100 requests/day (developer plan)
# Used for: Market news scanning for fundamental events

NEWS_API_KEY=

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
# For Sprint 1: SQLite is used (no setup needed)
# For Sprint 2+: PostgreSQL with TimescaleDB
# Install PostgreSQL locally or use cloud (Render free tier)

DATABASE_URL=sqlite:///sentinel.db

# PostgreSQL example (Sprint 2+):
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinel

# ─────────────────────────────────────────────
# KILL SWITCH
# ─────────────────────────────────────────────
# Secret token for the kill switch HTTP endpoint
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"

KILLSWITCH_SECRET=

# ─────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────

ENVIRONMENT=development      # development / production
LOG_LEVEL=INFO
